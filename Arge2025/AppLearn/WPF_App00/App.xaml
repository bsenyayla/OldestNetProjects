<Application x:Class="WPF_App00.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WPF_App00"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <LinearGradientBrush x:Key="NormalBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6A00" Offset="0"/>
            <GradientStop Color="#FF8C00" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF8C00" Offset="0"/>
            <GradientStop Color="#FFA500" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="DropShadow"
                      Color="Black"
                      Direction="320"
                      ShadowDepth="5"
                      BlurRadius="10"
                      Opacity="0.4"/>
    </Application.Resources>
</Application>

